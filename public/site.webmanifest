{
	"id": "/?id=00684331-2a10-4b94-b855-519b3446b49d",
	"scope": "/?utm_source=pwa&utm_medium=install&utm_campaign=web_app_manifest",
	"start_url": "/?utm_source=pwa&utm_medium=start_url&utm_campaign=web_app_manifest",
	"scope_extensions": [{ "type": "origin", "origin": "https://owt.madcampos.dev/" }],
	"name": "Old Web Text",
	"short_name": "OWT",
	"lang": "en-US",
	"dir": "ltr",
	"description": "A text styles generator for the cool kids.",
	"categories": ["entertainment", "utilities", "text"],
	"display": "standalone",
	"display_override": ["window-controls-overlay"],
	"orientation": "portrait",
	"background_color": "#f5f5f5",
	"theme_color": "#2e8b57",
	"color_scheme_dark": {
		"theme_color": "#2e8b57",
		"background_color": "#f5f5f5"
	},
	"prefer_related_applications": false,
	"icons": [
